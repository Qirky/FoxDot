#: FoxDot/lib/Workspace/Editor.py:70
msgid "New version available"
msgstr "Nova versão disponível"

#: FoxDot/lib/Workspace/Editor.py:71
msgid ""
"There is a new version of FoxDot available from PyPI. Upgrade by going to "
"your command prompt and running:\n"
"\n"
"pip install FoxDot --upgrade"
msgstr ""
"Há uma nova versão do FoxDot dispovível no PyPI. Atualize indo ao "
"seu prompt de comando e executando:\n"
"\n"
"pip install FoxDot --upgrade"

#: FoxDot/lib/Workspace/Editor.py:364
